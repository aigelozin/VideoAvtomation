# Скопируй в ~/VideoAutomation/.env (install.sh делает это сам) и заполни. Права: chmod 600.
# Пустое значение ключа = площадка/функция выключена, конвейер её пропускает.

# ═══ ЛОКАЛЬНАЯ МОДЕЛЬ (llama.cpp) ═══
LLM_BACKEND=llamacpp
LLM_URL=http://127.0.0.1:8080
LLM_MODEL=Qwen3.6-35B-A3B-MTP
LLM_CTX=32768
# сколько слов транскрипта читать для описания и названий
SAMPLE_WORDS=3000
META_TIMEOUT=180

# ═══ СТАТЬЯ ДЛЯ БЛОГА ═══
ARTICLE_MIN=600
ARTICLE_MAX=1000
# сколько слов транскрипта читать для плана статьи
ARTICLE_SAMPLE=6000

# ═══ ВЫГРУЗКА ═══
# archive.org/account/s3.php
ARCHIVE_ACCESS_KEY=
ARCHIVE_SECRET_KEY=
RUTUBE_LOGIN=
RUTUBE_PASSWORD=
# если вход только по SMS — токен из DevTools студии Rutube
RUTUBE_TOKEN=
# 1 = загружать скрытым (тест), 0 = открыто
RUTUBE_HIDDEN=1
RUTUBE_CATEGORY=13
# для загрузки без расписания: private | unlisted | public
YT_PRIVACY=private
# 27 = Образование
YT_CATEGORY=27

# ═══ WORDPRESS ═══
# https://адрес-блога
WP_URL=
WP_USER=
# Пользователи → Профиль → Пароли приложений
WP_APP_PASSWORD=
# без расписания: draft | publish
WP_STATUS=draft
# номер рубрики (tag_ID из адреса страницы рубрики)
WP_CATEGORY=

# ═══ РАСПИСАНИЕ (пусто = публиковать сразу после обработки) ═══
PUBLISH_SLOTS=пн 19:00, ср 19:00, пт 19:00
PUBLISH_TZ=Europe/Moscow
PUBLISH_MIN_LEAD_HOURS=3
YT_SCHEDULED_PRIVACY=public
WP_SCHEDULED_STATUS=publish

# ═══ TELEGRAM ═══
# от @BotFather
TG_BOT_TOKEN=
# @имя_канала или -100… (telegram.sh find)
TG_CHANNEL=
# пусто = как WP_CATEGORY
TG_WP_CATEGORY=

# ═══ НЕОБЯЗАТЕЛЬНО ═══
# CHANNEL_SIGNATURE=Международный Открытый Йога Университет · openyogaclass.com
# ARCHIVE_PREFIX=moyu
# ARCHIVE_COLLECTION=opensource_movies
# ARCHIVE_CREATOR_EN=International Open Yoga University
# ARCHIVE_SIGNATURE=International Open Yoga University · openyogaclass.com
